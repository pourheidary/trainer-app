{
  // Cloudflare deploy config: static website (the "app" folder) plus a small Worker for student share links.
  // "name" must match the project name typed in the Cloudflare dashboard.
  "name": "trainer-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    // Only these paths run the Worker; everything else is served as static files.
    "run_worker_first": ["/api/*", "/p/*"]
  },
  "kv_namespaces": [
    { "binding": "LINKS" }
  ]
}
